# Copy to fastlane/.env and fill in values. Never commit the real .env file.
# Quick setup: ./scripts/configure-credentials.sh <ISSUER_ID> [ASC_APP_APPLE_ID]

# Apple ID (required only for `bundle exec fastlane ios bootstrap_asc` — uses 2FA, not API key)
APPLE_ID=

# App Store Connect API key (Users and Access → Integrations → App Store Connect API)
# Key ID is in the .p8 filename: AuthKey_XXXXXXXXXX.p8
ASC_KEY_ID=
# Issuer ID — UUID at top of the API keys page (REQUIRED)
ASC_ISSUER_ID=
# Path to AuthKey_XXXXXXXXXX.p8 (store outside repo, e.g. ~/Keys/)
ASC_KEY_PATH=

# Numeric Apple ID of the app record in App Store Connect
# URL: https://appstoreconnect.apple.com/apps/1234567890/...
# Auto-discovered by: ./scripts/configure-credentials.sh <ISSUER_ID>
ASC_APP_APPLE_ID=

# TestFlight Internal Testing group (UUID from App Store Connect → TestFlight → Internal Testing)
ASC_INTERNAL_TESTING_GROUP_ID=40b17ded-4450-44d4-8ac6-a046ced5a03e

# Optional overrides
FASTLANE_TEAM_ID=M49XY93NTP
# FASTLANE_ITC_TEAM_ID=
